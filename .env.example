# paylink.lol Server Configuration
PORT=3000
BASE_URL=https://paylink.lol
NODE_ENV=production

# Database path (defaults to ./data/paylink.db)
DATABASE_PATH=./data/paylink.db

# Stripe Live / Test Configuration
# When ready for real cards, fill STRIPE_SECRET_KEY and set DEV_MOCK_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEV_MOCK_PAYMENTS=true

# Minimum bid amount (USD)
MIN_INITIAL_BID=0
MIN_OUTBID_INCREMENT=1

# Cloudflare Turnstile Invisible Bot Protection (Optional)
# Get keys from Cloudflare Dashboard -> Turnstile -> Add Site (Widget Mode: Invisible)
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Admin Dashboard Password (used to log in at /aras/admin)
ADMIN_PASSWORD=paylink_admin_secret_2026
